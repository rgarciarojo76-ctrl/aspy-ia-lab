# Configuración de Entorno (ASPY IA LAB)
# Renombra este archivo a .env.local para desarrollo local

# 1. Credenciales de Administrador (Acceso Fallback)
ADMIN_USER=admin
ADMIN_PASS=cambiar_esto_por_contraseña_segura

# 2. Lista de Usuarios Permitidos (Formato JSON array)
# Ejemplo: [{"username":"juan","password":"123"}]
AUTH_USERS=[{"username":"usuario_ejemplo","password":"password_ejemplo"}]

# 3. Secreto Compartido para "Token Handshake"
# Debe coincidir EXACTAMENTE con VITE_SHARED_SECRET en las apps externas
SHARED_SECRET=ASPY-SECRET-HANDSHAKE-2026-EXAMPLE
